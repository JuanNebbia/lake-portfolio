---
// Time-of-day hero: the sky, light and characters follow the visitor's local time.
// Layers, back to front: sky canvas → name → hills & water canvas → small copy.
// The hero stays pinned while the page scrolls; `water` names the element whose top edge
// becomes the rising water surface, so the sea turns into the background of the content below.
import { homePath, langFromUrl, languages, useT, type Lang } from '../i18n/ui';

interface Props {
  water?: string;
}
const { water } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const langs = Object.keys(languages) as Lang[];
---

<section class="hero" data-hero data-hero-water={water} data-lang={lang} aria-label={t['hero.label']}>
  <canvas class="back" data-hero-back aria-hidden="true"></canvas>
  <h1 class="name" data-hero-name><span class="word">Juan</span> <span class="word">Nebbia</span></h1>
  <canvas class="front" data-hero-front aria-hidden="true"></canvas>
  <div class="copy">
    <p class="eyebrow">// <time data-hero-clock>12:00</time> · <span data-hero-phase></span></p>
  </div>
  <!-- language switch: top right, part of the hero (it scrolls away with it) -->
  <nav class="langs" aria-label={t['lang.label']}>
    {langs.map((l, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        <a href={homePath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={languages[l]}>{l}</a>
      </>
    ))}
  </nav>
  <input class="sr-only" type="range" data-hero-hour min="0" max="23.99" step="0.25" value="12" aria-label={t['hero.time']} />
</section>

<script>
  import { initHero } from '../scripts/hero/hero';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
  .hero {
    --ink: #141a2b;
    --ink-soft: rgba(20, 26, 43, 0.72);
    --name: rgba(20, 26, 43, 0.88);
    position: sticky;
    top: 0;
    z-index: 0;
    width: 100%;
    /* the whole first screen; svh keeps it steady while mobile browser bars show and hide */
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    isolation: isolate;
    background: #5aa2dc;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .back { z-index: 0; }
  .front { z-index: 2; touch-action: pan-y; }
  .front:global(.grab) { cursor: grab; }
  .front:global(.dragging) { cursor: grabbing; }

  .name {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    pointer-events: none;
    font-family: var(--font-title);
    font-weight: 400;
    line-height: 1;
    color: var(--name);
    /* its own GPU layer: it scales, blurs and fades on every frame of the rising water */
    will-change: transform, filter, opacity;
  }
  /* on a phone the script stacks the words, so the name can be much bigger */
  .name:global(.stacked) { text-align: center; }
  .name:global(.stacked) .word { display: block; }

  .copy {
    position: absolute;
    z-index: 3;
    left: clamp(20px, 5vw, 56px);
    top: clamp(24px, 5vw, 52px);
    right: 20px;
    max-width: 380px;
    color: var(--ink);
    opacity: var(--copy-opacity, 1);
    pointer-events: none;
  }
  .eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .eyebrow time { font-variant-numeric: tabular-nums; }

  /* language switch, mirroring the clock on the other side; it fades with it as the water comes in */
  .langs {
    position: absolute;
    z-index: 3;
    top: clamp(24px, 5vw, 52px);
    right: clamp(20px, 5vw, 56px);
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-soft);
    opacity: var(--copy-opacity, 1);
  }
  .langs a {
    color: inherit;
    text-decoration: none;
    padding: 2px;
    border-radius: 3px;
  }
  .langs a:hover { color: var(--ink); }
  .langs a[aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .langs a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .role {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(16px, 1.8vw, 20px);
    letter-spacing: 0.01em;
  }
  .tag {
    margin: 8px 0 0;
    font-size: clamp(14px, 1.35vw, 15.5px);
    max-width: 34ch;
    color: var(--ink-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .hero:has(.sr-only:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* colours ease between ink tones only after the first frame, so the page doesn't load with a fade */
  .hero:global(.is-ready) .name,
  .hero:global(.is-ready) .copy,
  .hero:global(.is-ready) .eyebrow,
  .hero:global(.is-ready) .tag {
    transition: color 0.6s;
  }

</style>
