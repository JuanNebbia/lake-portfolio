---
import { homePath, langFromUrl, languages, useT, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const { title = t['meta.title'], description = t['meta.description'] } = Astro.props;
const site = Astro.site ?? Astro.url;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- tints the browser's bars (Safari, Chrome on Android); the hero keeps it in step with the sky -->
    <meta name="theme-color" content="#0d1225" />
    <meta name="description" content={description} />
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(homePath(l), site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath('en'), site).href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bungee+Shade&family=Unbounded:wght@500;700&family=Manrope:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f4f7;
    --fg: #1a1f2c;
    --muted: #5d6577;
    --accent: #3f5bd8;
    --font-title: 'Bungee Shade', 'Arial Black', sans-serif;
    --font-display: 'Unbounded', 'Arial Black', sans-serif;
    --font-body: 'Manrope', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
    /* water colours: night defaults, overwritten every frame by the hero to match its sky */
    --water: #0d1225;
    --water-ink: #eef1fa;
    --water-ink-soft: rgba(238, 241, 250, 0.72);
    --water-line: rgba(238, 241, 250, 0.16);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e1118;
      --fg: #e8ebf3;
      --muted: #9aa2b5;
      --accent: #8fa2ff;
      color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; }
  /* the page's own ground is the water: it shows behind mobile browser bars and on overscroll */
  html { background: var(--water); }
  body {
    background: var(--water);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
  }
</style>
