---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import MockContent from '../components/MockContent.astro';
---

<Base>
  <main>
    <Hero water="#content" />
    <!-- Everything below rides on the water: its top edge is the water surface rising over the hero -->
    <div class="content" id="content">
      <Projects />
      <MockContent />
    </div>
  </main>
</Base>

<style>
  .content {
    position: relative;
    z-index: 1;
    color: var(--water-ink);
    padding: 96px 16px 120px;
    display: grid;
    gap: 96px;
  }
</style>
